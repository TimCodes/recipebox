# Copy to .env and fill in. Loaded via node --env-file-if-exists (no dotenv dependency).

# --- Database ---
# Matches compose.dev.yaml defaults. POSTGRES_HOST_PORT is the *host* port; 5432 and 5433
# are already in use on this machine, hence 5442.
POSTGRES_USER=recipebox
POSTGRES_PASSWORD=recipebox
POSTGRES_DB=recipebox
POSTGRES_HOST_PORT=5442
DATABASE_URL=postgresql://recipebox:recipebox@localhost:5442/recipebox

# --- Servers ---
PORT=3000
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info

# --- AI (OpenAI) ---
# Optional. Without it the app runs fine and only the three AI features return 503.
OPENAI_API_KEY=

# Optional. Point at any OpenAI-compatible endpoint (local Ollama/LiteLLM proxy, Azure).
# Leave blank for api.openai.com.
# OPENAI_BASE_URL=

# Model per task. Defaults are tuned for low cost — ingestion especially, since one cookbook
# PDF fans out to as many as 12 calls. All three need strict json_schema structured outputs.
# Indicative $/1M tokens (in/out): gpt-5-nano 0.05/0.40 · gpt-4o-mini 0.15/0.60
#                                  gpt-5.6-luna 0.20/1.20 · gpt-5-mini 0.25/2.00
#                                  gpt-5.6-terra 2.00/12.00 (what Replit used)
# OPENAI_MODEL_INGEST=gpt-5-nano
# OPENAI_MODEL_RECIPE=gpt-5.6-luna
# OPENAI_MODEL_MEAL_PLAN=gpt-5.6-luna
# OPENAI_MODEL=            # overrides all three at once
