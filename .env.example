# Copy to .env and fill in. Loaded via node --env-file-if-exists (no dotenv dependency).

# --- Database ---
# Matches compose.dev.yaml defaults. POSTGRES_HOST_PORT is the *host* port; 5432 and 5433
# are already in use on this machine, hence 5442.
POSTGRES_USER=recipebox
POSTGRES_PASSWORD=recipebox
POSTGRES_DB=recipebox
POSTGRES_HOST_PORT=5442
DATABASE_URL=postgresql://recipebox:recipebox@localhost:5442/recipebox

# --- Servers ---
PORT=3000
BASE_PATH=/
NODE_ENV=development
LOG_LEVEL=info

# --- AI ---
# These are the Replit AI Integrations proxy vars. They are still required at import time by
# lib/integrations-openai-ai-server, so the API server will not boot without *something* here.
# The placeholder values below let the server start; the three AI features (recipe import,
# recipe generation, meal-plan generation) will fail at call time until this is replaced with a
# real provider. See DEREPLIT_PLAN.md section 6 — the model id `gpt-5.6-terra` is Replit-only.
AI_INTEGRATIONS_OPENAI_BASE_URL=http://localhost:9/unconfigured
AI_INTEGRATIONS_OPENAI_API_KEY=unconfigured-placeholder
